# Lambda Function URL for the contact form backend.
# After running the AWS setup in infra/contact-lambda/README.md,
# copy this file to .env and paste the URL printed by:
#   aws lambda get-function-url-config --function-name noc-portfolio-contact \
#     --query FunctionUrl --output text
PUBLIC_CONTACT_API_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-south-1.on.aws/
